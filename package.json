{
  "name": "uni-tree-view",
  "version": "0.4.2",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "description": "Cross-platform tree view component for uni-app and Vue 3, with single and multiple selection, filtering, lazy loading and virtual rendering",
  "author": "OFreshman <415561402@qq.com>",
  "license": "MIT",
  "homepage": "https://ofreshman.github.io/uni-tree-view/",
  "keywords": [
    "uni-tree-view",
    "uni-app",
    "uniapp",
    "uniapp-tree",
    "vue",
    "vue3",
    "component",
    "tree",
    "tree-view",
    "tree-component",
    "tree-select",
    "tree-selection",
    "selection",
    "checkbox",
    "lazy-loading",
    "virtual-list",
    "mini-program",
    "wechat-mini-program",
    "alipay-mini-program",
    "h5",
    "dcloud"
  ],
  "scripts": {
    "prepare": "simple-git-hooks",
    "play": "nr -C playground dev:h5",
    "play:mp-weixin": "nr -C playground dev:mp-weixin",
    "docs": "tsx scripts/dev-docs.ts",
    "docs:build": "pnpm -C playground build:h5:docs && pnpm -C docs build && pnpm docs:check",
    "docs:preview": "nr -C docs preview",
    "build": "pnpm --filter './packages/*' -r build",
    "build:play": "pnpm build && pnpm -C playground build:h5",
    "build:uni": "pnpm build && pnpm pack:uni",
    "pack:npm": "pnpm build && pnpm --filter './packages/core' pack --pack-destination artifacts/npm",
    "pack:uni": "tsx scripts/build-uni.ts",
    "clean": "rimraf **/dist **/dist-resolver **/uni_modules docs/public/ui --glob",
    "clean:uni": "rimraf ./artifacts/dcloud ./playground/src/uni_modules",
    "lint": "eslint --cache .",
    "lint:fix": "nr lint --fix",
    "lint:type": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.test.json && pnpm --filter './packages/core' lint:type && pnpm -C playground lint:type",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm lint && pnpm lint:type && pnpm test && pnpm build:play && git diff --check",
    "check:platforms": "pnpm -C playground build:mp-weixin && pnpm -C playground build:mp-alipay",
    "commit:check": "tsx scripts/check-commit-message.ts",
    "changelog": "pnpm changelog:generate",
    "changelog:check": "tsx scripts/generate-changelog.ts --check",
    "changelog:generate": "tsx scripts/generate-changelog.ts",
    "changelog:notes": "tsx scripts/extract-changelog-notes.ts",
    "changelog:package": "tsx scripts/sync-package-changelog.ts",
    "changelog:promote": "tsx scripts/update-changelog.ts",
    "release": "tsx scripts/release.ts",
    "release:prepare": "pnpm changelog:generate && pnpm changelog:promote && pnpm check && pnpm check:platforms",
    "release:push": "git push origin main --follow-tags",
    "docs:check": "tsx scripts/check-docs-build.ts"
  },
  "devDependencies": {
    "@antfu/ni": "catalog:dev",
    "@antfu/nip": "catalog:cli",
    "@dcloudio/types": "catalog:dev",
    "@dcloudio/uni-app": "catalog:prod",
    "@dcloudio/vite-plugin-uni": "catalog:build",
    "@mini-types/alipay": "catalog:dev",
    "@types/archiver": "catalog:types",
    "@types/fs-extra": "catalog:types",
    "@types/node": "catalog:types",
    "@uni-helper/uni-app-types": "catalog:dev",
    "@vitejs/plugin-vue": "catalog:build",
    "@vue/test-utils": "catalog:test",
    "@xiaohe01/eslint-config": "catalog:lint",
    "@xiaohe01/tsconfig": "catalog:dev",
    "archiver": "catalog:script",
    "bumpp": "catalog:cli",
    "chalk": "catalog:node",
    "consola": "catalog:node",
    "eslint": "catalog:lint",
    "eslint-plugin-pnpm": "catalog:lint",
    "fs-extra": "catalog:node",
    "happy-dom": "catalog:test",
    "lint-staged": "catalog:lint",
    "miniprogram-api-typings": "catalog:dev",
    "pncat": "catalog:cli",
    "rimraf": "catalog:node",
    "simple-git-hooks": "catalog:lint",
    "tsx": "catalog:script",
    "typescript": "catalog:dev",
    "unbuild": "catalog:build",
    "vite": "catalog:build",
    "vitest": "catalog:test",
    "vue": "catalog:frontend",
    "vue-tsc": "catalog:dev"
  },
  "simple-git-hooks": {
    "commit-msg": "pnpm exec tsx scripts/check-commit-message.ts --allow-merge \"$1\"",
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,ts,tsx,vue,json}": "eslint --fix"
  }
}