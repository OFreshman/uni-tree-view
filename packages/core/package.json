{
  "name": "uni-tree-view",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@10.11.0",
  "description": "一个基于 Vue3 / uni-app 的跨平台树形列表/选择组件，兼容小程序 (dCloud 插件市场) 和 H5",
  "author": "OFreshman <415561402@qq.com>",
  "license": "MIT",
  "homepage": "https://ofreshman.github.io/uni-tree-view/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OFreshman/uni-tree-view.git"
  },
  "bugs": "https://github.com/OFreshman/uni-tree-view/issues",
  "keywords": [
    "tree",
    "tree-view",
    "tree select",
    "uniapp tree",
    "uni-tree-view"
  ],
  "sideEffects": [
    "./src/components/**/*.vue"
  ],
  "exports": {
    ".": {
      "types": "./src/components/uni-tree-view/uni-tree-view.vue.d.ts",
      "import": "./src/components/uni-tree-view/uni-tree-view.vue"
    },
    "./shared": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.js"
    },
    "./resolver": {
      "types": "./dist-resolver/index.d.ts",
      "import": "./dist-resolver/index.mjs",
      "require": "./dist-resolver/index.cjs"
    },
    "./global": "./src/global.d.ts",
    "./*": "./src/*"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "dist",
    "dist-resolver",
    "src"
  ],
  "scripts": {
    "build": "nr clean:dist && unbuild && tsx scripts/post-build.ts",
    "clean:dist": "rimraf ./dist ./dist-resolver",
    "lint:type": "vue-tsc --noEmit -p tsconfig.check.json && tsc --noEmit -p tsconfig.node.json",
    "prepack": "pnpm -w changelog:package"
  },
  "peerDependencies": {
    "vue": ">=3.3.0"
  },
  "devDependencies": {
    "@types/node": "catalog:types",
    "@uni-helper/vite-plugin-uni-components": "catalog:build",
    "@uni-helper/vite-plugin-uni-pages": "catalog:build",
    "@vue/runtime-core": "catalog:dev",
    "tsx": "catalog:script",
    "typescript": "catalog:dev",
    "vue": "catalog:frontend",
    "vue-tsc": "catalog:dev"
  }
}